{
  "name": "@toklyn/store",
  "version": "0.3.0",
  "license": "MIT",
  "description": "PostgreSQL, MySQL/MariaDB and Redis session and access-token revocation stores for toklyn.",
  "keywords": [
    "toklyn",
    "session-store",
    "postgres",
    "postgresql",
    "mysql",
    "mariadb",
    "redis",
    "valkey",
    "upstash",
    "auth",
    "refresh-token"
  ],
  "author": "Gulshan Kumar Singh",
  "homepage": "https://github.com/singhgulshan/toklyn/tree/main/packages/store#readme",
  "bugs": "https://github.com/singhgulshan/toklyn/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/singhgulshan/toklyn.git",
    "directory": "packages/store"
  },
  "type": "module",
  "sideEffects": false,
  "exports": {
    "./postgres": {
      "import": {
        "types": "./dist/postgres/index.d.ts",
        "default": "./dist/postgres/index.js"
      },
      "require": {
        "types": "./dist/postgres/index.d.cts",
        "default": "./dist/postgres/index.cjs"
      }
    },
    "./mysql": {
      "import": {
        "types": "./dist/mysql/index.d.ts",
        "default": "./dist/mysql/index.js"
      },
      "require": {
        "types": "./dist/mysql/index.d.cts",
        "default": "./dist/mysql/index.cjs"
      }
    },
    "./redis": {
      "import": {
        "types": "./dist/redis/index.d.ts",
        "default": "./dist/redis/index.js"
      },
      "require": {
        "types": "./dist/redis/index.d.cts",
        "default": "./dist/redis/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "imports": {
    "#src/*": "./src/*"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "tsup",
    "prepublishOnly": "pnpm run build",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "check:exports": "attw --pack . --profile node16"
  },
  "peerDependencies": {
    "toklyn": "workspace:^"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@electric-sql/pglite": "^0.5.13",
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "ioredis": "^6.0.0",
    "mariadb": "^3.5.4",
    "mysql2": "^3.24.6",
    "pg": "^8.23.1",
    "postgres": "^4.0.0",
    "redis": "^6.3.1",
    "toklyn": "workspace:^",
    "tsup": "^9.0.0",
    "vitest": "^5.0.5"
  }
}