{
  "name": "@toklyn/next",
  "version": "0.1.0",
  "license": "MIT",
  "description": "Next.js App Router helpers for toklyn sessions: route handlers, proxy and server components.",
  "keywords": [
    "toklyn",
    "next",
    "nextjs",
    "app-router",
    "auth",
    "authentication",
    "jwt",
    "refresh-token",
    "ssr"
  ],
  "author": "Gulshan Kumar Singh",
  "homepage": "https://github.com/singhgulshan/toklyn/tree/main/packages/next#readme",
  "bugs": "https://github.com/singhgulshan/toklyn/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/singhgulshan/toklyn.git",
    "directory": "packages/next"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./server": {
      "import": {
        "types": "./dist/server.d.ts",
        "default": "./dist/server.js"
      },
      "require": {
        "types": "./dist/server.d.cts",
        "default": "./dist/server.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "imports": {
    "#src/*": "./src/*"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "tsup",
    "prepublishOnly": "pnpm run build",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:edge": "vitest run --environment edge-runtime",
    "check:exports": "attw --pack . --profile node16"
  },
  "peerDependencies": {
    "next": ">=15.0.0",
    "toklyn": "workspace:^"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@edge-runtime/vm": "^5.0.0",
    "@types/node": "^26.6.6",
    "next": "^16.4.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "toklyn": "workspace:^",
    "tsup": "^9.0.0",
    "vitest": "^5.0.5"
  },
  "peerDependenciesMeta": {
    "next": {
      "optional": true
    }
  }
}
