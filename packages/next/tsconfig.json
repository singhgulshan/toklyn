{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    // Only for vitest.config.ts; test:edge catches Node APIs in src.
    "types": [
      "node"
    ],
    // Type-check against core sources so a fresh checkout needs no build first.
    "paths": {
      "toklyn": [
        "../core/src/index.ts"
      ],
      "toklyn/http": [
        "../core/src/http/index.ts"
      ],
      // Next has no exports map, so nodenext needs help with its extensionless subpaths.
      "next/*": [
        "./node_modules/next/*.d.ts"
      ]
    }
  },
  "include": [
    "src",
    "tests",
    "tsup.config.ts",
    "vitest.config.ts"
  ]
}