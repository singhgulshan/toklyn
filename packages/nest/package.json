{
  "name": "@toklyn/nest",
  "version": "0.5.0",
  "license": "MIT",
  "description": "NestJS module, guard and decorators for toklyn sessions.",
  "keywords": [
    "toklyn",
    "nestjs",
    "nest",
    "auth",
    "authentication",
    "jwt",
    "refresh-token",
    "guard"
  ],
  "author": "Gulshan Kumar Singh",
  "homepage": "https://github.com/singhgulshan/toklyn/tree/main/packages/nest#readme",
  "bugs": "https://github.com/singhgulshan/toklyn/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/singhgulshan/toklyn.git",
    "directory": "packages/nest"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "imports": {
    "#src/*": "./src/*"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "tsup",
    "prepublishOnly": "pnpm run build",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "check:exports": "attw --pack . --profile node16"
  },
  "peerDependencies": {
    "@nestjs/common": ">=9.0.0",
    "@nestjs/core": ">=9.0.0",
    "toklyn": "workspace:^"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@nestjs/common": "^12.3.2",
    "@nestjs/core": "^12.3.2",
    "@nestjs/platform-express": "^12.3.2",
    "@nestjs/platform-fastify": "^12.3.2",
    "@nestjs/testing": "^12.3.2",
    "@types/node": "^26.6.6",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "toklyn": "workspace:^",
    "tsup": "^9.0.0",
    "vitest": "^5.0.5"
  }
}
