{
  "name": "toklyn",
  "version": "0.5.1",
  "license": "MIT",
  "description": "Access and refresh token sessions with rotation, reuse detection and pluggable storage.",
  "keywords": [
    "auth",
    "authentication",
    "jwt",
    "access-token",
    "refresh-token",
    "token-rotation",
    "session",
    "cookie",
    "typescript"
  ],
  "author": "Gulshan Kumar Singh",
  "homepage": "https://github.com/singhgulshan/toklyn/tree/main/packages/core#readme",
  "bugs": "https://github.com/singhgulshan/toklyn/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/singhgulshan/toklyn.git",
    "directory": "packages/core"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./http": {
      "import": {
        "types": "./dist/http/index.d.ts",
        "default": "./dist/http/index.js"
      },
      "require": {
        "types": "./dist/http/index.d.cts",
        "default": "./dist/http/index.cjs"
      }
    },
    "./testing": {
      "import": {
        "types": "./dist/testing/index.d.ts",
        "default": "./dist/testing/index.js"
      },
      "require": {
        "types": "./dist/testing/index.d.cts",
        "default": "./dist/testing/index.cjs"
      }
    },
    "./test-utils": {
      "import": {
        "types": "./dist/test-utils/index.d.ts",
        "default": "./dist/test-utils/index.js"
      },
      "require": {
        "types": "./dist/test-utils/index.d.cts",
        "default": "./dist/test-utils/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "imports": {
    "#src/*": "./src/*"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "tsup",
    "prepublishOnly": "pnpm run build",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:edge": "vitest run --environment edge-runtime",
    "check:exports": "attw --pack . --profile node16"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@edge-runtime/vm": "^5.0.0",
    "tsup": "^9.0.0",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "jose": "^6.2.13"
  },
  "peerDependencies": {
    "vitest": ">=5.0.0"
  },
  "peerDependenciesMeta": {
    "vitest": {
      "optional": true
    }
  }
}