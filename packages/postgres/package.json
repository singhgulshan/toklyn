{
  "name": "@toklyn/postgres",
  "version": "0.1.0",
  "license": "MIT",
  "description": "PostgreSQL session and access-token revocation stores for toklyn.",
  "keywords": [
    "toklyn",
    "postgres",
    "postgresql",
    "session-store",
    "auth",
    "refresh-token"
  ],
  "author": "Gulshan Kumar Singh",
  "homepage": "https://github.com/singhgulshan/toklyn/tree/main/packages/postgres#readme",
  "bugs": "https://github.com/singhgulshan/toklyn/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/singhgulshan/toklyn.git",
    "directory": "packages/postgres"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "imports": {
    "#src/*": "./src/*"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "tsup",
    "prepublishOnly": "pnpm run build",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "check:exports": "attw --pack . --profile node16"
  },
  "peerDependencies": {
    "toklyn": "workspace:^"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@electric-sql/pglite": "^0.5.13",
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "pg": "^8.23.1",
    "postgres": "^4.0.0",
    "toklyn": "workspace:^",
    "tsup": "^9.0.0",
    "vitest": "^5.0.5"
  }
}
