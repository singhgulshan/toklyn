{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "types": [
      "node"
    ],
    // The generated Prisma client imports its own files with `.ts` extensions.
    "allowImportingTsExtensions": true,
    // Type-check against sources so a fresh checkout needs no build first.
    "paths": {
      "toklyn": [
        "../../packages/core/src/index.ts"
      ],
      "@toklyn/store/*": [
        "../../packages/store/src/*/index.ts"
      ]
    }
  },
  "include": [
    "src"
  ]
}