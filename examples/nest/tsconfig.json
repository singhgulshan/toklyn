{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "types": [
      "node"
    ],
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    // Type-check against sources so a fresh checkout needs no build first.
    "paths": {
      "toklyn": [
        "../../packages/core/src/index.ts"
      ],
      "toklyn/http": [
        "../../packages/core/src/http/index.ts"
      ],
      "@toklyn/nest": [
        "../../packages/nest/src/index.ts"
      ]
    }
  },
  "include": [
    "src"
  ]
}