# Copy to .env and fill in. `pnpm start` loads it; never commit .env.

# Required. Signing secret, at least 32 bytes, used as text. Generate with:
#   openssl rand -base64 32
TOKLYN_SECRET=

# Optional. The previous secret while rotating: accepted for verification only.
# Remove it once the last access token signed with it has expired.
TOKLYN_SECRET_PREVIOUS=

# Optional. Set as `iss` and `aud` on every token and checked on verify.
# Several audiences are comma-separated.
TOKLYN_ISSUER=
TOKLYN_AUDIENCE=

# Optional. Origins trusted for cookie-authenticated writes (refresh, logout), comma-separated.
TOKLYN_ALLOWED_ORIGINS=

# Optional. Share cookies across subdomains, e.g. example.com. Changes the cookie prefix
# from __Host- to __Secure-, which signs out existing sessions.
TOKLYN_COOKIE_DOMAIN=
