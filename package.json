{
  "name": "toklyn-monorepo",
  "private": true,
  "scripts": {
    "format": "prettier --write \"{packages,examples}/*/{src,tests,public}/**/*.{ts,tsx,js,html}\"",
    "format:check": "prettier --check \"{packages,examples}/*/{src,tests,public}/**/*.{ts,tsx,js,html}\"",
    "lint": "oxlint packages/ examples/",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "test:edge": "pnpm -r test:edge",
    "check:exports": "pnpm -r check:exports",
    "changeset": "changeset",
    "version-packages": "changeset version && pnpm install --lockfile-only",
    "release": "pnpm build && changeset publish"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "packageManager": "pnpm@12.16.1+sha512.091d1dee7927575661b25dab3c2ae31cafc1c54d6b71ed6a6600cf0c1cb10434a447eae14015f1b23e2e6bedeed79df94a932e2164d2832280dce3fb32f656d1",
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "@trivago/prettier-plugin-sort-imports": "^6.0.2",
    "oxlint": "^1.90.0",
    "prettier": "^3.9.10",
    "typescript": "^6.0.3"
  }
}